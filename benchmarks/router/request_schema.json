{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeeplyTunedRouterRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "constraints", "output_format", "acceptance_checks"],
  "properties": {
    "task_type": {
      "type": "string",
      "enum": ["auto", "math_logic", "code", "ops", "planning", "writing"]
    },
    "goal": {
      "type": "string",
      "minLength": 5
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output_format": {
      "type": "string",
      "minLength": 2
    },
    "acceptance_checks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "context": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
