# Image / container
IMAGE_NAME=deeply-tuned-llama
IMAGE_TAG=latest
CONTAINER_NAME=deeply-tuned-server

# Host model mount
MODEL_ROOT=/storage/models/Qwen3-32B-GGUF
MODEL_FILE=Qwen3-32B-Q6_K.gguf

# Server
SERVER_PORT=8080
CTX_SIZE=16384
THREADS=16
PARALLEL=1
BATCH_SIZE=512
UBATCH_SIZE=256
N_GPU_LAYERS=999
SPLIT_MODE=row
TENSOR_SPLIT=24,24
FLASH_ATTN=off

# KV cache (start with quality-safe defaults)
CACHE_TYPE_K=f16
CACHE_TYPE_V=f16
CHAT_TEMPLATE=
REASONING_FORMAT=none
REASONING_BUDGET=0
PROMPT_CACHE_RAM=0
SEED=42
ROUTER_GATEWAY_MODE=on
BACKEND_PORT=8081
GATEWAY_MAX_RETRIES=2
GATEWAY_FAIL_ON_VERIFY=off
